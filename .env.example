# Copy to .env in the project directory. Never commit your actual key.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
OPENAI_API_KEY=
# To use OpenAI: LLM_PROVIDER=openai and LLM_MODEL=gpt-4.1-mini.
# A blank LLM_MODEL uses the selected provider's default.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1800
# Temporary memory; use a single server worker.
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=100
MAX_HISTORY_TURNS=12
ROMAJI_ENABLED=false
# Shared placement, learning memory, conversations and study plans. Keep this database private.
ASSESSMENT_DB_PATH=data/assessment.sqlite3
ASSESSMENT_TTL_SECONDS=86400

# Local defaults. For Render, enter staging values in its Environment page.
ENVIRONMENT=development
# Same-origin staging URL for server-side origin checks behind Render's TLS proxy.
FRONTEND_URL=
# Empty locally means SQLite. Staging requires the Supabase PostgreSQL URL.
# Never paste the real URL into source, logs, browser code or chat.
DATABASE_URL=
STAGING_ACCESS_ENABLED=false
STAGING_ACCESS_CODE=
STAGING_SESSION_SECRET=
STAGING_SESSION_HOURS=168
# Phase 12A preparation only; true is rejected until Phase 12B implementation.
# Leave both Supabase Auth values blank on the current deployment.
# This URL is the project HTTPS origin, not DATABASE_URL or the tutor website.
ACCOUNT_AUTH_ENABLED=false
# Separate Fernet keys (current first, up to two older rotation keys); never commit.
ACCOUNT_SESSION_ENCRYPTION_KEYS=
# Exact UUIDs of owner-invited Supabase Auth users, comma-separated (max 20).
ACCOUNT_INVITED_IDS=
SUPABASE_AUTH_URL=
SUPABASE_AUTH_PUBLISHABLE_KEY=
SUPABASE_AUTH_TIMEOUT_SECONDS=5
SCOPE_ENFORCEMENT_ENABLED=false
AI_RATE_LIMIT_PER_HOUR=40
AI_GLOBAL_RATE_LIMIT_PER_HOUR=200
# Enable only after the fallback key and model are configured server-side.
LLM_FAILOVER_ENABLED=false
LLM_FALLBACK_PROVIDER=groq
GROQ_API_KEY=
# Example supported schema model; verify access in your Groq account.
GROQ_MODEL=openai/gpt-oss-20b
# Reuses GROQ_API_KEY; enable only after Free-plan/billing and privacy checks.
# Dedicated Whisper STT; no effect on the text-generation provider/model.
STT_ENABLED=true
STT_TIMEOUT_SECONDS=30
STT_RATE_LIMIT_PER_HOUR=6
STT_GLOBAL_RATE_LIMIT_PER_HOUR=30
STT_GLOBAL_RATE_LIMIT_PER_DAY=300

# Optional private retrieval. Build/import the index explicitly before enabling.
# Uses DATABASE_URL on staging; separate ignored SQLite index locally.
KNOWLEDGE_ENABLED=false
KNOWLEDGE_DB_PATH=knowledge_base/index.sqlite3
KNOWLEDGE_TOP_K=3
KNOWLEDGE_CONTEXT_LIMIT=6000
KNOWLEDGE_MIN_SCORE=0.35
